<?xml version="1.0" encoding="utf-8"?>
<!--
  备份规则（Android 12+ / API 31+）。

  与 res/xml/backup_rules.xml 同样的理由：bamboo_actions.xml 里有 Keystore 加密的
  API Key，而 Keystore 密钥不出设备，备份出去只会在新机器上留一串解不开的垃圾。
  所以这里把该文件同时从「云备份」和「设备间迁移」里排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="bamboo_actions.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="bamboo_actions.xml" />
    </device-transfer>
</data-extraction-rules>
